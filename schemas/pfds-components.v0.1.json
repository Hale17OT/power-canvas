                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                }
              },
              "required": [
                "type",
                "screen"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
