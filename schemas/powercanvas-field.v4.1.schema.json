{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_]\\w*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "default": "text",
      "type": "string",
      "enum": [
        "text",
        "multiline",
        "number",
        "currency",
        "percentage",
        "email",
        "phone",
        "url",
        "boolean",
        "toggle",
        "singleChoice",
        "multiChoice",
        "date",
        "datetime",
        "lookup",
        "person"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "onChange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "required": {
      "default": false,
      "type": "boolean"
    },
    "readOnly": {
      "default": false,
      "type": "boolean"
    },
    "disabled": {
      "default": "false",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "helpText": {
      "default": "",
      "type": "string"
    },
    "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "timeZone": {
      "type": "string",
      "enum": [
        "UTC",
        "Local"
      ]
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "validation": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "const": "range"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "rule",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "const": "length"
              },
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "rule",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "const": "date"
              },
              "after": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "before": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "rule",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "const": "predicate"
              },
              "expression": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "rule",
              "expression",
              "message"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "sourceBinding": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "dataType": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "column",
        "dataType"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "label",
    "value",
    "onChange"
  ],
  "additionalProperties": false
}
