{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "source": {
      "type": "string"
    },
    "atmosphere": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visualCharacter": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "density": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "notes"
      ],
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "semanticRoles": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "strategy",
        "roles",
        "semanticRoles"
      ],
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "properties": {
        "hierarchy": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "token": {
                "type": "string",
                "pattern": "^PF_"
              },
              "size": {
                "type": "number",
                "minimum": 12,
                "maximum": 64
              }
            },
            "required": [
              "role",
              "token",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "philosophy": {
          "type": "string"
        }
      },
      "required": [
        "hierarchy",
        "philosophy"
      ],
      "additionalProperties": false
    },
    "spacing": {
      "type": "object",
      "properties": {
        "scale": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "philosophy": {
          "type": "string"
        }
      },
      "required": [
        "scale",
        "philosophy"
      ],
      "additionalProperties": false
    },
    "radius": {
      "type": "object",
      "properties": {
        "scale": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "philosophy": {
          "type": "string"
        }
      },
      "required": [
        "scale",
        "philosophy"
      ],
      "additionalProperties": false
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "flat",
            "layered",
            "reading",
            "focused"
          ]
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "borders": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "hairline",
            "sectionless"
          ]
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "elevation": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "none",
            "overlay-only"
          ]
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "properties": {
        "characteristics": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "characteristics"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "properties": {
        "treatments": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "treatments"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "principles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "principles"
      ],
      "additionalProperties": false
    },
    "responsive": {
      "type": "object",
      "properties": {
        "principles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "principles"
      ],
      "additionalProperties": false
    },
    "dos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "donts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "powerAppsAdaptation": {
      "type": "object",
      "properties": {
        "supported": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "translated": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupported": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "supported",
        "translated",
        "unsupported"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "atmosphere",
    "visualCharacter",
    "density",
    "color",
    "typography",
    "spacing",
    "radius",
    "surfaces",
    "borders",
    "elevation",
    "navigation",
    "components",
    "layout",
    "responsive",
    "dos",
    "donts",
    "powerAppsAdaptation"
  ],
  "additionalProperties": false
}
