{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "navigation": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "label",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "titleField": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "subtitleField": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "statusField": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "select": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "selected": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "selectedTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "selectedBody": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "commands": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "label",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "fields": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "onChange": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "required": [
              "label",
              "value",
              "onChange"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_]\\w*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "default": "text",
                "type": "string",
                "enum": [
                  "text",
                  "multiline",
                  "number",
                  "currency",
                  "percentage",
                  "email",
                  "phone",
                  "url",
                  "boolean",
                  "toggle",
                  "singleChoice",
                  "multiChoice",
                  "date",
                  "datetime",
                  "lookup",
                  "person"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "onChange": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "readOnly": {
                "default": false,
                "type": "boolean"
              },
              "disabled": {
                "default": "false",
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "helpText": {
                "default": "",
                "type": "string"
              },
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "timeZone": {
                "type": "string",
                "enum": [
                  "UTC",
                  "Local"
                ]
              },
              "currencyCode": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "validation": {
                "default": [],
                "maxItems": 12,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "rule": {
                          "type": "string",
                          "const": "range"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rule",
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "rule": {
                          "type": "string",
                          "const": "length"
                        },
                        "min": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rule",
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "rule": {
                          "type": "string",
                          "const": "date"
                        },
                        "after": {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        },
                        "before": {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rule",
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "rule": {
                          "type": "string",
                          "const": "predicate"
                        },
                        "expression": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20000
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "rule",
                        "expression",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "sourceBinding": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string"
                  },
                  "column": {
                    "type": "string"
                  },
                  "dataType": {
                    "type": "string"
                  }
                },
                "required": [
                  "table",
                  "column",
                  "dataType"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "label",
              "value",
              "onChange"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "empty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "loading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "retry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "canCommit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "filters": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chartItems": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "chartMaximum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "metricLabel": {
      "type": "string"
    },
    "timelineItems": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "group": {
      "default": "\"\"",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "groupStart": {
      "default": "false",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "filterPredicate": {
      "default": "true",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "selectionCount": {
      "default": "0",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "clearSelection": {
      "default": "false",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "taskContext": {
      "type": "object",
      "properties": {
        "originScreen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "originRecord": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "originNavigationState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "dirty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "returnAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "discardAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "originScreen",
        "originRecord",
        "originNavigationState",
        "dirty",
        "returnAction",
        "discardAction"
      ],
      "additionalProperties": false
    },
    "documentPreview": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "external-link"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "kind",
        "title",
        "url",
        "description"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "default": false,
      "type": "boolean"
    },
    "fixtureRows": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "title",
          "subtitle",
          "status",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "subtitle",
    "navigation",
    "items",
    "titleField",
    "subtitleField",
    "statusField",
    "select",
    "selected",
    "selectedTitle",
    "selectedBody",
    "commands",
    "fields",
    "empty",
    "loading",
    "error",
    "retry",
    "commit",
    "canCommit",
    "filters",
    "chartItems",
    "chartMaximum",
    "metric",
    "metricLabel",
    "timelineItems"
  ],
  "additionalProperties": false
}
