{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device": {
      "default": "desktop",
      "type": "string",
      "enum": [
        "desktop",
        "tablet",
        "mobile"
      ]
    },
    "rendered": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "primaryActionInViewport": {
            "type": "boolean"
          },
          "simultaneousListAndDetail": {
            "type": "boolean"
          },
          "visibleFieldCount": {
            "type": "number",
            "minimum": 0
          },
          "desktopChromeInTask": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "primaryActionInViewport",
          "simultaneousListAndDetail",
          "visibleFieldCount",
          "desktopChromeInTask"
        ],
        "additionalProperties": false
      }
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
