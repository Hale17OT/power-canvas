{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "powercanvas.connectors/v1alpha1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,7}_PowerCanvas[A-Za-z0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "apiKey"
            },
            "header": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            }
          },
          "required": [
            "type",
            "header"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth2"
            },
            "authorizationUrl": {
              "type": "string",
              "format": "uri"
            },
            "tokenUrl": {
              "type": "string",
              "format": "uri"
            },
            "scopes": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "required": [
            "type",
            "authorizationUrl",
            "tokenUrl",
            "scopes"
          ],
          "additionalProperties": false
        }
      ]
    },
    "operations": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "method": {
            "type": "string",
            "const": "GET"
          },
          "path": {
            "type": "string",
            "pattern": "^\\/[a-zA-Z0-9/_-]*$"
          },
          "parameters": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "integer"
                  ]
                },
                "required": {
                  "default": false,
                  "type": "boolean"
                },
                "maximum": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "response": {
            "type": "object",
            "properties": {
              "collection": {
                "type": "boolean"
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "collectionFormat": {
                "default": "items",
                "type": "string",
                "enum": [
                  "items",
                  "array"
                ]
              },
              "pagination": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "cursor"
                ]
              }
            },
            "required": [
              "collection",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "summary",
          "method",
          "path",
          "response"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "name",
    "title",
    "baseUrl",
    "auth",
    "operations"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "object"
          ]
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "nullable": {
          "default": false,
          "type": "boolean"
        },
        "fields": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    }
  }
}
