{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "purpose": {
      "type": "string",
      "const": "PROVIDER_CERTIFICATION"
    },
    "receiptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1
    },
    "targetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "solutionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
    },
    "publisherId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
    },
    "ownershipRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ownershipHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorizedOperationIds": {
      "minItems": 6,
      "maxItems": 21,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ownedPrerequisitesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resolvedTablePrivileges": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tableResourceId": {
            "type": "string"
          },
          "tableId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "logicalName": {
            "type": "string"
          },
          "schemaName": {
            "type": "string"
          },
          "privilegeType": {
            "type": "string"
          },
          "depth": {
            "type": "string",
            "enum": [
              "Basic",
              "Local",
              "Deep",
              "Global"
            ]
          },
          "privilegeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "name": {
            "type": "string"
          },
          "canBeBasic": {
            "type": "boolean"
          },
          "canBeLocal": {
            "type": "boolean"
          },
          "canBeDeep": {
            "type": "boolean"
          },
          "canBeGlobal": {
            "type": "boolean"
          },
          "legacyProjectionName": {
            "type": "string"
          }
        },
        "required": [
          "tableResourceId",
          "tableId",
          "logicalName",
          "schemaName",
          "privilegeType",
          "depth",
          "privilegeId",
          "name",
          "canBeBasic",
          "canBeLocal",
          "canBeDeep",
          "canBeGlobal",
          "legacyProjectionName"
        ],
        "additionalProperties": false
      }
    },
    "authorizedRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "additive",
          "securityWrite"
        ]
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "purpose",
    "receiptId",
    "manifestHash",
    "planHash",
    "environmentId",
    "targetHash",
    "solutionId",
    "publisherId",
    "ownershipRevision",
    "ownershipHash",
    "authorizedOperationIds",
    "authorizedRisks",
    "issuedAt",
    "expiresAt",
    "contentHash"
  ],
  "additionalProperties": false
}
