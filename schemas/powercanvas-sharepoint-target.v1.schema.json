{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "#/$defs/__schema0"
    },
    "tenantId": {
      "$ref": "#/$defs/__schema1"
    },
    "environment": {
      "$ref": "#/$defs/__schema2"
    },
    "sites": {
      "$ref": "#/$defs/__schema3"
    },
    "resources": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "tenantId",
    "environment",
    "sites"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "SHAREPOINT_SIMULATION"
    },
    "__schema1": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema4"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expectedSiteId": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "__schema4": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "__schema6": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema4"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "site": {
            "$ref": "#/$defs/__schema4"
          },
          "id": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "required": [
          "site",
          "id"
        ],
        "additionalProperties": false
      }
    }
  }
}
