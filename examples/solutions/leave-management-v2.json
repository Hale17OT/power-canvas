    "workflowRecipes": {
      "approval": {
        "purpose": "Request explicit reviewer approval and notify on confirmed approval.",
        "flow": {
          "logicalName": "pcn_Review",
          "displayName": "Leave Management review",
          "flowType": "instant",
          "trigger": {
            "type": "powerAppsV2"
          },
          "inputs": [
            {
              "name": "title",
              "shape": {
                "type": "string"
              }
            }
          ],
          "outputs": [],
          "connectionReferences": [
            "approvals",
            "mail"
          ],
          "environmentVariables": [
            "approver"
          ],
          "runPolicy": {
            "mode": "controlledWrite"
          },
          "activationPolicy": "manual"
        },
        "steps": [
          {
            "recipe": "approval",
            "name": "Review",
            "mode": "startAndWait",
            "timeoutHours": 24,
            "request": {
              "name": "Request",
              "use": "approvals.startAndWait",
              "connection": "approvals",
              "approvalType": "firstToRespond",
              "assignedTo": [
                {
                  "op": "environment",
                  "name": "approver"
                }
              ],
              "title": {
                "op": "input",
                "name": "title"
              },
              "enableNotifications": true,
              "timeoutHours": 24
            },
            "onApproved": [
              {
                "recipe": "notification",
                "name": "Notify",
                "send": {
                  "name": "Notify",
                  "use": "outlook.sendEmail",
                  "connection": "mail",
                  "to": [
                    {
                      "op": "environment",
                      "name": "approver"
                    }
                  ],
                  "subject": {
                    "op": "literal",
                    "value": "Leave Management approved",
                    "shape": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "op": "literal",
                    "value": "Review the approved record in the app.",
                    "shape": {
                      "type": "string"
                    }
                  }
                },
                "errorBehavior": "stop",
                "idempotencyIntent": "Operator reconciliation before any uncertain external retry."
              }
            ],
            "onRejected": [],
            "onUnknown": []
          }
        ],
        "idempotency": {
          "mode": "operatorReviewed",
          "rationale": "Compile-only benchmark; no approver authorization or runtime activation."
        },
        "response": {}
      },
