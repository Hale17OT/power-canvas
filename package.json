{
  "name": "powercanvas",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "Deterministic Power Platform project validation and safe delivery foundation",
  "type": "module",
  "bin": {
    "powercanvas": "dist/cli/index.js",
    "powerforge": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "npm run build && vitest run",
    "test:live": "npm run build && node scripts/live-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "powercanvas": "node dist/cli/index.js",
    "schema": "npm run build && node scripts/schema.mjs",
    "test:visual": "npm run design:benchmarks && playwright test",
    "test:visual:update": "npm run design:benchmarks && playwright test --update-snapshots",
    "build:pcf": "npm --prefix pcf/Timeline run build",
    "design:benchmarks": "npm run build && node scripts/design-v4-benchmarks.mjs",
    "design:v41": "npm run build && node scripts/design-v41-benchmarks.mjs",
    "test:design-visual": "npm run design:benchmarks && playwright test design-v4.spec.mjs",
    "agent:eval": "npm run build && node scripts/package-agent-plugin.mjs --check && node scripts/agent-eval.mjs",
    "agent:package": "node scripts/package-agent-plugin.mjs",
    "solution:benchmarks": "npm run build && node scripts/solution-benchmarks.mjs",
    "solution:v2": "npm run build && node scripts/solution-v2-benchmarks.mjs",
    "solution:sharepoint": "npm run build && node scripts/sharepoint-benchmarks.mjs",
    "sharepoint:simulate": "npm run build && node scripts/sharepoint-simulate.mjs",
    "pcf:certify": "npm run build && node scripts/pcf-certify.mjs",
    "pcf:binding:certify": "npm run build && node scripts/pcf-binding-certify.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.1",
    "@azure/msal-node-extensions": "5.5.1",
    "commander": "15.0.0",
    "xmlbuilder2": "4.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
